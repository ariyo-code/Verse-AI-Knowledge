{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verse API Verification Evidence — V24",
  "type": "object",
  "required": [
    "evidence_id",
    "symbol_id",
    "api_version",
    "source_url",
    "reviewed_at",
    "review_status"
  ],
  "properties": {
    "evidence_id": {
      "type": "string",
      "minLength": 1
    },
    "symbol_id": {
      "type": "string",
      "minLength": 1
    },
    "api_version": {
      "type": "string",
      "minLength": 1
    },
    "source_url": {
      "type": "string",
      "pattern": "^https://dev\\.epicgames\\.com/"
    },
    "reviewed_at": {
      "type": "string"
    },
    "reviewed_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "review_status": {
      "enum": [
        "candidate",
        "presence",
        "verified",
        "rejected"
      ]
    },
    "signature": {
      "type": [
        "string",
        "null"
      ]
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "default": {
            "type": [
              "string",
              "null"
            ]
          },
          "optional": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "return_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "effects": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "fields_verified": {
      "type": "array",
      "items": {
        "enum": [
          "presence",
          "module",
          "kind",
          "signature",
          "parameters",
          "return_type",
          "effects",
          "event_names",
          "event_payloads",
          "member_names"
        ]
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
