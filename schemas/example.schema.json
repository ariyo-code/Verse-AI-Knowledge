{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verse AI Example Metadata",
  "type": "object",
  "required": [
    "title",
    "status",
    "tested_in_uefn",
    "multiplayer_tested"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "compiled",
        "verified",
        "multiplayer-verified",
        "deprecated"
      ]
    },
    "source_type": {
      "enum": [
        "official",
        "original",
        "community-unverified"
      ]
    },
    "verse_api": {
      "type": [
        "string",
        "null"
      ]
    },
    "tested_in_uefn": {
      "type": "boolean"
    },
    "multiplayer_tested": {
      "type": "boolean"
    },
    "last_verified": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_url": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}