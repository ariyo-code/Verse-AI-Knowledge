{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verse AI Example Metadata",
  "type": "object",
  "required": ["title", "validation", "tested_in_uefn", "multiplayer_tested"],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "validation": {"$ref": "validation_status.schema.json"},
    "source_trust": {"$ref": "trust.schema.json"},
    "lifecycle_status": {"enum": ["active", "deprecated", "planned", "template", "discovered"]},
    "status": {"type": "string", "description": "Legacy compatibility field."},
    "source_type": {"type": "string"},
    "verse_api": {"type": ["string", "null"]},
    "tested_in_uefn": {"type": "boolean"},
    "multiplayer_tested": {"type": "boolean"},
    "last_verified": {"type": ["string", "null"]},
    "source_url": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
