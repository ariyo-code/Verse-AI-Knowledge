{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UEFN System Memory",
  "type": "object",
  "required": [
    "id",
    "name",
    "status",
    "purpose",
    "dependencies",
    "verification"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "template",
        "planned",
        "discovered",
        "compiled",
        "verified",
        "deprecated"
      ]
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "responsibilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "runtime_state": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "persistent_state": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_api": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "edge_cases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "public_interfaces": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "events_consumed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "events_emitted": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "devices": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification": {
      "type": "object"
    }
  },
  "additionalProperties": true
}