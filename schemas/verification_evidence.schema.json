{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UEFN Verification Evidence",
  "type": "object",
  "required": ["artifact", "validation", "verse_api", "checks"],
  "properties": {
    "artifact": {"type": "string", "minLength": 1},
    "validation": {"enum": ["static-checked", "compiled", "verified", "multiplayer-verified"]},
    "status": {"enum": ["compiled", "verified", "multiplayer-verified"], "description": "Legacy compatibility field."},
    "verse_api": {"type": "string"},
    "checked_at": {"type": "string"},
    "checks": {
      "type": "object",
      "required": ["static_checked", "compiled", "runtime_tested", "multiplayer_tested"],
      "properties": {
        "static_checked": {"type": "boolean"},
        "compiled": {"type": "boolean"},
        "runtime_tested": {"type": "boolean"},
        "multiplayer_tested": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "evidence": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
