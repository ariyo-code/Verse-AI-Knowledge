{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UEFN Compile Queue Entry",
  "type": "object",
  "required": [
    "candidate_id",
    "source_id",
    "source_path",
    "queue_status",
    "local_verification"
  ],
  "properties": {
    "candidate_id": {
      "type": "string"
    },
    "source_id": {
      "type": "string"
    },
    "source_path": {
      "type": "string"
    },
    "queue_status": {
      "enum": [
        "pending",
        "staged",
        "compiling",
        "compile-failed",
        "blocked-environment",
        "compiled",
        "runtime-pending",
        "verified",
        "skipped"
      ]
    },
    "failure_classification": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "syntax-or-language",
        "api-or-version",
        "missing-dependency",
        "project-environment",
        "unknown",
        null
      ]
    },
    "local_verification": {
      "type": "object",
      "properties": {
        "compiled": {
          "type": "boolean"
        },
        "runtime_tested": {
          "type": "boolean"
        },
        "multiplayer_tested": {
          "type": "boolean"
        }
      }
    },
    "compile_attempts": {
      "type": "array"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}