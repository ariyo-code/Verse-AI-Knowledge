{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verse / UEFN Error Memory Entry",
  "type": "object",
  "required": [
    "id",
    "created_at",
    "status",
    "category",
    "exact_message",
    "source",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 8
    },
    "created_at": {
      "type": "string",
      "minLength": 10
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "observed",
        "diagnosed",
        "fixed",
        "verified",
        "deprecated"
      ]
    },
    "category": {
      "enum": [
        "compiler",
        "runtime",
        "logic",
        "deprecation",
        "mcp",
        "unknown"
      ]
    },
    "exact_message": {
      "type": "string",
      "minLength": 1
    },
    "normalized_message": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "uefn",
            "verse-compiler",
            "runtime-log",
            "manual"
          ]
        },
        "file": {
          "type": [
            "string",
            "null"
          ]
        },
        "line": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "column": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      },
      "additionalProperties": true
    },
    "version": {
      "type": "object",
      "required": [
        "uefn_or_api"
      ],
      "properties": {
        "uefn_or_api": {
          "type": "string"
        },
        "project_revision": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "faulty_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "minimal_reproduction": {
      "type": [
        "string",
        "null"
      ]
    },
    "cause": {
      "type": [
        "string",
        "null"
      ]
    },
    "correction": {
      "type": [
        "string",
        "null"
      ]
    },
    "corrected_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "verification": {
      "type": "object",
      "properties": {
        "compiled": {
          "type": "boolean"
        },
        "runtime_tested": {
          "type": "boolean"
        },
        "multiplayer_tested": {
          "type": "boolean"
        },
        "evidence": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "related_api": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "related_files": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}