{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verse AI Benchmark Run",
  "type": "object",
  "required": [
    "run_id",
    "created_at",
    "tasks"
  ],
  "properties": {
    "run_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "model_or_agent": {
      "type": [
        "string",
        "null"
      ]
    },
    "verse_api": {
      "type": "string"
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "task_id",
          "static_score",
          "compile_score",
          "runtime_score",
          "multiplayer_score"
        ],
        "properties": {
          "task_id": {
            "type": "string"
          },
          "static_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 40
          },
          "compile_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 25
          },
          "runtime_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 20
          },
          "multiplayer_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 15
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  },
  "additionalProperties": true
}