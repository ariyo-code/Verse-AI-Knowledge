{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "artifact_id",
    "repo_revision",
    "api_snapshot",
    "scenario",
    "observed_result",
    "result"
  ],
  "properties": {
    "artifact_id": {
      "type": "string"
    },
    "repo_revision": {
      "type": "string"
    },
    "api_snapshot": {
      "type": "string"
    },
    "scenario": {
      "type": "string"
    },
    "observed_result": {
      "type": "string"
    },
    "result": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "logs": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
