{
  "schema_version": 1,
  "marker_version": "v21",
  "default_marker": "<!-- verse-ai-generated:v21 -->",
  "metadata_template": "<!-- verse-ai-generated:v21;lang=verse;status={status} -->",
  "allowed_statuses": [
    "draft",
    "static-checked",
    "upstream-verified",
    "compiled",
    "verified",
    "multiplayer-verified"
