{
  "schema_version": 2,
  "marker_version": "v22",
  "default_marker": "<!-- verse-ai-generated:v22 -->",
  "metadata_template": "<!-- verse-ai-generated:v22;lang=verse;status={status} -->",
  "default_status": "draft",
  "allowed_statuses": [
    "draft",
    "static-checked",
    "compiled",
    "verified",
    "multiplayer-verified"
  ],
  "placement": "Immediately after each generated Verse file section in Markdown when provenance marking is used.",
  "safety": {
    "html_comment_only": true,
    "invisible_unicode": false,
    "zero_width_characters": false,
    "bidi_controls": false,
    "unicode_tags": false
  },
  "rules": {
    "claim_compiled_without_evidence": false,
    "source_trust_is_not_validation": true
  }
}
